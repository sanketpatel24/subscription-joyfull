{{ 'product-details-accordion.css' | asset_url | stylesheet_tag }}


{%- liquid
  assign benefits = closest.product.metafields.custom.benefits
  assign directions = closest.product.metafields.custom.directions
  assign ingredients = closest.product.metafields.custom.ingredients_oh
-%}

{%- if benefits != blank or directions != blank or ingredients != blank -%}
  <div class="product-details-accordion" {{ block.shopify_attributes }}>
    {%- for index in (1..3) -%}
      {%- liquid
        case index
          when 1
            assign heading = 'Benefits'
            assign content = benefits
          when 2
            assign heading = 'Directions'
            assign content = directions
          when 3
            assign heading = 'Ingredients'
            assign content = ingredients
        endcase
      -%}

      {%- if content != blank -%}
        <details class="product-details-accordion__item">
          <summary class="product-details-accordion__summary">
            <span>{{ heading }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M12 5.75L7.5 10.25L3 5.75" stroke="#2F261C" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>

          <div class="product-details-accordion__content">
            {%- if content.type == 'rich_text_field' -%}
              {{ content | metafield_tag }}
            {%- else -%}
              <p>{{ content.value | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Product details accordion",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Product details accordion"
    }
  ]
}
{% endschema %}
