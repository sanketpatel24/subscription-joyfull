    <div class="subscription-selector__option subscription-selector__option--onetime">
      <div  class="subscription-selector__option_inner">
      <div class="subscription-selector__badge">
        <span>{{ onetime_badge_text | escape }}</span>
        {% if block.settings.show_per_packet and packet_count > 0 %}
          <span class="subscription-selector__badge-price">
            {{ variant.price | divided_by: packet_count | money_without_trailing_zeros }}
            {{ per_packet_label | escape }}
          </span>
        {% endif %}
      </div>

      <label class="subscription-selector__summary">
        <input
          type="radio"
          name="purchase-option-{{ block.id }}"
          value="onetime"
          data-purchase-option="onetime"
          data-onetime-price="{{ variant.price | money_without_trailing_zeros | escape }}"
          {% if block.settings.show_per_packet and packet_count > 0 %}
            data-onetime-per-packet="{{ variant.price | divided_by: packet_count | money_without_trailing_zeros | escape }}"
          {% endif %}
        >
        <span class="subscription-selector__radio" aria-hidden="true"></span>
        <span class="subscription-selector__title">{{ onetime_label | escape }}</span>
        <span class="subscription-selector__price">{{ variant.price | money_without_trailing_zeros }}</span>
      </label>
    </div>
    </div>
  </subscription-selector>
{% elsif request.design_mode %}
  <div class="subscription-selector" {{ block.shopify_attributes }}>
    {{ 'products.product.subscription.missing_selling_plan' | t }}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.subscription_selector",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:settings.subscription_badge",
      "default": "Best Value"
    },
    {
      "type": "text",
      "id": "onetime_badge_text",
      "label": "t:settings.one_time_badge",
      "default": "Getting Started"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "t:settings.subscription_label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "t:settings.one_time_label",
      "default": "One-Time Purchase"
    },
    {
      "type": "text",
      "id": "delivery_label",
      "label": "t:settings.delivery_label",
      "default": "Deliver every:"
    },
    {
      "type": "checkbox",
      "id": "show_per_packet",
      "label": "t:settings.show_price_per_packet",
      "default": true
    },
    {
      "type": "text",
      "id": "per_packet_label",
      "label": "t:settings.per_packet_suffix",
      "default": "per packet"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "t:settings.subscription_benefit_1",
      "default": "Save an additional 10% on every order"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "t:settings.subscription_benefit_2",
      "default": "Free shipping, always"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "t:settings.subscription_benefit_3",
      "default": "Cancel or pause anytime"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#fff3ce"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "#2f261c"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "t:settings.badge_background",
      "default": "#2f261c"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:settings.badge_text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:names.subscription_selector",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
