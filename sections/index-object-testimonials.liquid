{%- if section.settings.testimonial_item != blank -%}
    {%- assign testimonial_item = section.settings.testimonial_item -%}
{%- endif -%}

{%- liquid
    assign background_color = section.settings.background_color
    assign information_color = section.settings.information_color
    assign desktop_top_padding = section.settings.desktop_top_padding
    assign desktop_bottom_padding = section.settings.desktop_bottom_padding
    assign mobile_top_padding = section.settings.mobile_top_padding
    assign mobile_bottom_padding = section.settings.mobile_bottom_padding

    assign main_heading_size = section.settings.main_heading_size
    assign follow_us_text = section.settings.follow_us_text

    assign main_top_heading_text = testimonial_item.main_top_heading_text.value
    assign follow_us_custom_logo = testimonial_item.follow_us_custom_logo.value
    assign follow_us_custom_link = testimonial_item.follow_us_custom_link.value
    assign select_testimonial_lists = testimonial_item.select_testimonial_lists.value
-%}

{%- if main_top_heading_text != blank or follow_us_custom_logo != blank or select_testimonial_lists != blank -%}
    {{ 'index-object-testimonials.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'index-object-testimonials.js' | asset_url }}" defer></script>

    {%- style -%}
        #shopify-section-{{ section.id }} .testimonials {
            {%- if background_color != blank -%}
                --background-color: {{ background_color }};
            {%- endif -%}
            {%- if information_color != blank -%}
                --information-color: {{ information_color }};
            {%- endif -%}
            {%- if desktop_top_padding != blank -%}
                --desktop-top-padding: {{ desktop_top_padding }}px;
            {%- endif -%}
            {%- if desktop_bottom_padding != blank -%}
                --desktop-bottom-padding: {{ desktop_bottom_padding }}px;
            {%- endif -%}
            {%- if mobile_top_padding != blank -%}
                --mobile-top-padding: {{ mobile_top_padding }}px;
            {%- endif -%}
            {%- if mobile_bottom_padding != blank -%}
                --mobile-bottom-padding: {{ mobile_bottom_padding }}px;
            {%- endif -%}
        }
    {%- endstyle -%}

    <section class="testimonials">
        <div class="page-width">
            <div class="testimonials__body">
                {%- if main_top_heading_text != blank -%}
                    <div class="testimonials__title">
                        <div class="testimonials__title-wrap">
                            <{{ main_heading_size }} class="heading-m">
                                {{ main_top_heading_text | escape }}
                            </{{ main_heading_size }}>
                        </div>
                    </div>
                {%- endif -%}
                {%- if follow_us_custom_logo != blank -%}
                    <div class="testimonials__block">
                        {%- if follow_us_custom_link != blank -%}
                            <a href="{{ follow_us_custom_link | escape }}">
                        {%- endif -%}
                            <div class="testimonials__block-wrap">
                                {%- if follow_us_text != blank -%}
                                    <div class="badge-medium bold testimonials__text">
                                        {{ follow_us_text | escape }}
                                    </div>
                                {%- endif -%}
                                <div class="testimonials__link">
                                    {% render 'responsive-image-lazyload',
                                        desktop_image: follow_us_custom_logo,
                                        mobile_image: follow_us_custom_logo,
                                        class: 'custom--image',
                                        sizes: '320px',
                                        desktop_widths: '320, 640',
                                        mobile_widths: '320, 640'
                                    %}
                                </div>
                            </div>
                        {%- if follow_us_custom_link != blank -%}
                            </a>
                        {%- endif -%}
                    </div>
                {%- endif -%}
                {%- if select_testimonial_lists != blank -%}
                    <div class="testimonials__loop">
                        <div class="testimonials__loop-wrap">
                            <div class="index-object-testimonials-marquee">
                                <span>
                                    {%- for select_testimonial_lists in select_testimonial_lists -%}
                                        {%- liquid
                                            assign descriptions = select_testimonial_lists.descriptions
                                            assign custom_icon = select_testimonial_lists.custom_icon.value
                                            assign author_name = select_testimonial_lists.author_name.value
                                            assign custom_text = select_testimonial_lists.custom_text.value
                                        -%}
                                        {%- if descriptions != blank or custom_icon != blank or author_name != blank or custom_text != blank -%}
                                            <div class="testimonials__detail">
                                                <div class="testimonials__detail-wrap">
                                                    {%- if descriptions != blank or custom_icon != blank -%}
                                                        <div class="testimonials__item">
                                                            <div class="testimonials__item-star">
