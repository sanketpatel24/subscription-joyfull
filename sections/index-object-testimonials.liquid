                                                            {%- if descriptions != blank -%}
                                                                <div class="badge-large bold testimonials__item-info">
                                                                    {{ descriptions | metafield_tag }}
                                                                </div>
                                                            {%- endif -%}
                                                            {%- if custom_icon != blank -%}
                                                                <div class="testimonials__item-icon">
                                                                    {% render 'responsive-image-lazyload',
                                                                        desktop_image: custom_icon,
                                                                        mobile_image: custom_icon,
                                                                        class: 'custom--image',
                                                                        sizes: '112px',
                                                                        desktop_widths: '112, 224',
                                                                        mobile_widths: '112, 224'
                                                                    %}
                                                                </div>
                                                            {%- endif -%}
                                                        </div>
                                                    {%- endif -%}
                                                    {%- if author_name != blank or custom_text != blank -%}
                                                        <div class="testimonials__both">
                                                            {%- if author_name != blank -%}
                                                                <div class="badge-large bold testimonials__both-name">
                                                                    {{ author_name | escape }}
                                                                </div>
                                                            {%- endif -%}
                                                            {%- if custom_text != blank -%}
                                                                <div class="badge-small testimonials__both-text">
                                                                    {{ custom_text | escape }}
                                                                </div>
                                                            {%- endif -%}
                                                        </div>
                                                    {%- endif -%}
                                                </div>
                                            </div>
                                        {%- endif -%}
                                        {%- assign image_video = select_testimonial_lists.image_video.value -%}
                                        {%- if image_video != blank -%}
                                            <div class="testimonials__media">
                                                <div class="testimonials__media-wrap">
                                                    {%- if image_video contains "files" -%}
                                                        {% render 'responsive-image-lazyload',
                                                            desktop_image: image_video,
                                                            mobile_image: image_video,
                                                            class: 'custom--image',
                                                            sizes: '(max-width: 749px) 100vw, 100vw'
                                                        %}
                                                    {%- else -%}
                                                        {% render 'responsive-video-lazyload',
                                                            video_url: image_video,
                                                            class: 'video--desktop video--mobile'
                                                        %} 
                                                    {%- endif -%}
                                                </div>
                                            </div>
                                        {%- endif -%}
                                    {%- endfor -%}
                                </span>
                            </div>
                        </div>
                    </div>
                {%- endif -%}
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "Index Object Testimonials",
    "class": "index-object-testimonials__section",
    "settings": [
        {
            "type": "header",
            "content": "==== Color Settings ===="
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color"
        },
        {
            "type": "color",
            "id": "information_color",
            "label": "Information Color"
        },
        {
            "type": "header",
            "content": "==== Layout Settings ===="
        },
        {
            "type": "number",
            "id": "desktop_top_padding",
            "label": "Desktop Top Padding",
            "default": 80
        },
        {
            "type": "number",
            "id": "desktop_bottom_padding",
            "label": "Desktop Bottom Padding",
            "default": 80
        },
        {
            "type": "number",
            "id": "mobile_top_padding",
            "label": "Mobile Top Padding",
            "default": 40
        },
        {
            "type": "number",
            "id": "mobile_bottom_padding",
            "label": "Mobile Bottom Padding",
            "default": 112
        },
        {
            "type": "header",
            "content": "==== Content Settings ===="
        },
        {
            "type": "select",
            "id": "main_heading_size",
            "label": "Main Heading Size",
            "default": "h2",
            "options": [
                {
                    "label": "H1",
                    "value": "h1"
                },
                {
                    "label": "H2",
                    "value": "h2"
                },
                {
                    "label": "H3",
                    "value": "h3"
                },
                {
                    "label": "H4",
                    "value": "h4"
                },
                {
                    "label": "H5",
                    "value": "h5"
                },
                {
                    "label": "H6",
                    "value": "h6"
                },
                {
                    "label": "Span",
                    "value": "span"
                }
            ]
        },
        {
            "type": "text",
            "id": "follow_us_text",
            "label": "Follow Us Text",
            "default": "Follow us"
        },
        {
            "type": "metaobject",
            "id": "testimonial_item",
            "label": "Select Testimonial Item",
            "metaobject_type": "home_testimonial_selections"
        }
    ],
    "presets": [
        {
            "name": "Index Object Testimonials"
        }
    ]
}
