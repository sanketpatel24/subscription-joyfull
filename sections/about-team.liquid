{{ 'about-team.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --about-team-background: {{ section.settings.background_color }};
    --about-team-desktop-padding-top: {{ section.settings.desktop_top_padding }}px;
    --about-team-desktop-padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
    --about-team-mobile-padding-top: {{ section.settings.mobile_top_padding }}px;
    --about-team-mobile-padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
  }
{%- endstyle -%}

<section
  class="about-team"
  {% if section.settings.heading != blank %}
    aria-labelledby="AboutTeamHeading-{{ section.id }}"
  {% endif %}
>
  {%- if section.settings.left_decorative_icons != blank or section.settings.right_decorative_icons != blank -%}
    <div class="about-team__decorations" aria-hidden="true">
      {%- if section.settings.left_decorative_icons != blank -%}
        {%- render 'responsive-media-asset',
          desktop_image: section.settings.left_decorative_icons,
          mobile_image: section.settings.left_decorative_icons,
          wrapper_class: 'about-team__decoration about-team__decoration--left',
          picture_class: 'about-team__decoration-picture',
          image_class: 'about-team__decoration-image',
          desktop_width: 640,
          desktop_widths: '320, 480, 640',
          desktop_sizes: '320px',
          mobile_widths: '320',
          mobile_sizes: '100vw',
            desktop_media: '(min-width: 990px)',
            mobile_media: '(max-width: 989px)',
            decorative: true,
            preserve_vector: true
        -%}
      {%- endif -%}
      {%- if section.settings.right_decorative_icons != blank -%}
        {%- render 'responsive-media-asset',
          desktop_image: section.settings.right_decorative_icons,
          mobile_image: section.settings.right_decorative_icons,
          wrapper_class: 'about-team__decoration about-team__decoration--right',
          picture_class: 'about-team__decoration-picture',
          image_class: 'about-team__decoration-image',
          desktop_width: 288,
          desktop_widths: '144, 216, 288',
          desktop_sizes: '144px',
          mobile_widths: '144',
          mobile_sizes: '100vw',
            desktop_media: '(min-width: 990px)',
            mobile_media: '(max-width: 989px)',
            decorative: true,
            preserve_vector: true
        -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="about-team__inner page-width">
    <header class="about-team__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="about-team__heading heading-m" id="AboutTeamHeading-{{ section.id }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}
    </header>

    <div class="about-team__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video | default: desktop_video
        -%}
          <article class="about-team__card" {{ block.shopify_attributes }}>
            <div class="about-team__media-frame">
              {%- render 'responsive-media-asset',
                desktop_video: desktop_video,
                mobile_video: mobile_video,
                desktop_image: desktop_image,
                mobile_image: mobile_image,
                wrapper_class: 'about-team__asset',
                picture_class: 'about-team__picture',
                video_class: 'about-team__media',
                image_class: 'about-team__media',
                placeholder_class: 'about-team__placeholder',
                desktop_width: 1000,
                desktop_widths: '384, 576, 768, 1000',
                desktop_sizes: '384px',
                mobile_widths: '303, 480, 600, 750',
                mobile_sizes: 'calc(100vw - 72px)',
                desktop_media: '(min-width: 990px)',
                mobile_media: '(max-width: 989px)',
                show_placeholder: true
              -%}
            </div>
            <div class="about-team__card-content">
              {%- if block.settings.name != blank -%}
                <h3 class="about-team__name heading-s">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <p class="about-team__role title-large">{{ block.settings.role | escape }}</p>
              {%- endif -%}
              {%- if block.settings.biography != blank -%}
                <div class="about-team__biography text-common">{{ block.settings.biography }}</div>
              {%- endif -%}
              {%- if block.settings.fun_fact != blank -%}
                <div class="about-team__fun-fact text-common">
                  <strong>Fun fact:</strong>
                  {{ block.settings.fun_fact }}
                </div>
              {%- endif -%}
            </div>
          </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
    "name": "About Team",
    "class": "about-team__section",
    "max_blocks": 20,
    "settings": [
        {
            "type": "header",
            "content": "==== Color Settings ===="
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#2F57A4"
        },
        {
            "type": "header",
            "content": "==== Media Settings ===="
        },
        {
            "type": "image_picker",
            "id": "left_decorative_icons",
            "label": "Left Decorative Icons"
        },
        {
            "type": "image_picker",
            "id": "right_decorative_icons",
            "label": "Right Decorative Icons"
        },
        {
            "type": "header",
            "content": "==== Content Settings ===="
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading Text",
            "default": "The humans behind JoyFull"
        },
        {
            "type": "header",
            "content": "==== Layout Settings ===="
        },
        {
            "type": "number",
            "id": "desktop_top_padding",
            "label": "Desktop Top Padding",
            "default": 80
        },
        {
            "type": "number",
            "id": "desktop_bottom_padding",
            "label": "Desktop Bottom Padding",
            "default": 68
        },
        {
            "type": "number",
            "id": "mobile_top_padding",
            "label": "Mobile Top Padding",
            "default": 32
        },
        {
            "type": "number",
            "id": "mobile_bottom_padding",
            "label": "Mobile Bottom Padding",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "member",
            "name": "Team Member",
            "settings": [
                {
                    "type": "header",
                    "content": "==== Media Settings ===="
                },
                {
                    "type": "video",
                    "id": "desktop_video",
                    "label": "Desktop Video"
                },
                {
                    "type": "video",
                    "id": "mobile_video",
                    "label": "Mobile Video"
                },
                {
                    "type": "image_picker",
                    "id": "desktop_image",
                    "label": "Desktop Image"
                },
                {
                    "type": "image_picker",
                    "id": "mobile_image",
                    "label": "Mobile Image"
                },
                {
                    "type": "header",
                    "content": "==== Content Settings ===="
                },
                {
                    "type": "text",
                    "id": "name",
                    "label": "Name",
                    "default": "Team Member"
                },
                {
                    "type": "text",
                    "id": "role",
                    "label": "Role",
                    "default": "Role"
                },
                {
                    "type": "richtext",
                    "id": "biography",
                    "label": "Biography",
                    "default": "<p>Share the team member's story.</p>"
                },
                {
                    "type": "richtext",
                    "id": "fun_fact",
                    "label": "Fun Fact"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "About Team",
            "blocks": [
                {
                    "type": "member"
                },
                {
                    "type": "member",
                    "settings": {
                        "name": "Dr. Natascha",
                        "role": "JoyFull’s Veterinary Advisor"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
