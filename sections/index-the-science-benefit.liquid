                                                    </div>
                                                {%- endif -%}
                                                {%- if detail != blank -%}
                                                    <div class="answer">
                                                        <div class="text-common accordion__answer-common">
                                                            {{ detail }}
                                                        </div>
                                                    </div>
                                                {%- endif -%}
                                            </li>
                                        {%- endif -%}
                                    {%- endfor -%}
                                </ul>
                            </div>
                        </div>
                    </div>
                {%- endif -%}
                {%- if button_text != blank and button_link != blank -%}                                    
                    <div class="science__links show--mobile">
                        {%- render 'button-common-style',                                                  
                            main_button_text: button_text, 
                            main_button_link: button_link,
                            main_button_style: button_style
                        -%}
                    </div>                                    
                {%- endif -%}
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "Index The Science Benefit",
    "class": "index-the-science-benefit__section",
    "settings": [
        {
            "type": "header",
            "content": "==== Color Settings ===="
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color"
        },
        {
            "type": "color",
            "id": "information_color",
            "label": "Information Color"
        },
        {
            "type": "header",
            "content": "==== Layout Settings ===="
        },
        {
            "type": "number",
            "id": "desktop_top_padding",
            "label": "Desktop Top Padding",
            "default": 80
        },
        {
            "type": "number",
            "id": "desktop_bottom_padding",
            "label": "Desktop Bottom Padding",
            "default": 116
        },
        {
            "type": "number",
            "id": "mobile_top_padding",
            "label": "Mobile Top Padding",
            "default": 32
        },
        {
            "type": "number",
            "id": "mobile_bottom_padding",
            "label": "Mobile Bottom Padding",
            "default": 32
        },
        {
            "type": "header",
            "content": "==== Media Settings ===="
        },
        {
            "type": "image_picker",
            "id": "main_desktop_image",
            "label": "Add Main Desktop Image"
        },
        {
            "type": "image_picker",
            "id": "main_mobile_image",
            "label": "Add Main Mobile Image"
        },
        {
            "type": "header",
            "content": "==== Content Settings ===="
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "Heading Size",
            "default": "h2",
            "options": [
                {
                    "label": "H1",
                    "value": "h1"
                },
                {
                    "label": "H2",
                    "value": "h2"
                },
                {
                    "label": "H3",
                    "value": "h3"
                },
                {
                    "label": "H4",
                    "value": "h4"
                },
                {
                    "label": "H5",
                    "value": "h5"
                },
                {
                    "label": "H6",
                    "value": "h6"
                },
                {
                    "label": "Span",
                    "value": "span"
                }
            ]
        },
        {
            "type": "textarea",
            "id": "heading_text",
            "label": "Heading Text",
            "default": "Built from the gut up"
        },
        {
            "type": "richtext",
            "id": "details_text",
            "label": "Details Text",
            "default": "<p>We did the research, read the labels, and couldn't ignore what we saw. Some brands aren't just missing the mark on gut health, they're formulated in ways that actively disrupt it. So we built Joyfull from the gut up, with ingredients chosen to support it.</p>"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "The Science"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link",
            "default": "/"
        },
        {
            "type": "select",
            "id": "button_style",
            "label": "Button Style",
            "default": "secondary-button",
            "options": [
                {
                    "label": "Primary Button",
                    "value": "primary-button"
                },
                {
                    "label": "Secondary Button",
                    "value": "secondary-button"
                }
            ]
        }
    ],
    "blocks": [
        {
            "type": "information",
            "name": "Information",
            "limit": 4,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Heading",
                    "default": "Lorem Ipsum is simply dummy text"
                },
                {
                    "type": "richtext",
                    "id": "detail",
                    "label": "Detail",
                    "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Index The Science Benefit",
            "blocks": [
                {
                    "type": "information"
                },
                {
                    "type": "information"
