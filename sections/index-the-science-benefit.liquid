{%- liquid
    assign background_color = section.settings.background_color
    assign information_color = section.settings.information_color
    assign desktop_top_padding = section.settings.desktop_top_padding
    assign desktop_bottom_padding = section.settings.desktop_bottom_padding
    assign mobile_top_padding = section.settings.mobile_top_padding
    assign mobile_bottom_padding = section.settings.mobile_bottom_padding

    assign main_desktop_image = section.settings.main_desktop_image
    assign main_mobile_image = section.settings.main_mobile_image

    assign heading_size = section.settings.heading_size
    assign heading_text = section.settings.heading_text
    assign details_text = section.settings.details_text
    assign button_text = section.settings.button_text
    assign button_link = section.settings.button_link
    assign button_style = section.settings.button_style
-%}

{%- if heading_text != blank or details_text != blank or button_link != blank or main_desktop_image != blank or main_mobile_image != blank or section.blocks.size > 0 -%}
    {{ 'index-the-science-benefit.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'index-the-science-benefit.js' | asset_url }}" defer></script>

    {%- style -%}
        #shopify-section-{{ section.id }} .science {
            {%- if background_color != blank -%}
                --background-color: {{ background_color }};
            {%- endif -%}
            {%- if information_color != blank -%}
                --information-color: {{ information_color }};
            {%- endif -%}
            {%- if desktop_top_padding != blank -%}
                --desktop-top-padding: {{ desktop_top_padding }}px;
            {%- endif -%}
            {%- if desktop_bottom_padding != blank -%}
                --desktop-bottom-padding: {{ desktop_bottom_padding }}px;
            {%- endif -%}
            {%- if mobile_top_padding != blank -%}
                --mobile-top-padding: {{ mobile_top_padding }}px;
            {%- endif -%}
            {%- if mobile_bottom_padding != blank -%}
                --mobile-bottom-padding: {{ mobile_bottom_padding }}px;
            {%- endif -%}
        }
    {%- endstyle -%}

    <section class="science">
        <div class="page-width">
            <div class="science__body">
                {%- if heading_text != blank or details_text != blank or button_link != blank -%}
                    <div class="science__detail">
                        <div class="science__detail-wrap">
                            {%- if heading_text != blank -%}
                                <div class="heading-m science__title">
                                    <{{ heading_size }}>
                                        {{ heading_text | newline_to_br }}
                                    </{{ heading_size }}>
                                </div>                                    
                            {%- endif -%}
                            {%- if details_text != blank -%}
                                <div class="text-common science__infos">
                                    {{ details_text }}
                                </div>                                    
                            {%- endif -%}
                            {%- if button_text != blank and button_link != blank -%}                                    
                                <div class="science__links show--desktop">
                                    {%- render 'button-common-style',                                                  
                                        main_button_text: button_text, 
                                        main_button_link: button_link,
                                        main_button_style: button_style
                                    -%}
                                </div>                                    
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
                {%- if main_desktop_image != blank and main_mobile_image != blank -%}
                    <div class="science__media">
                        <div class="science__media-wrap">
                            {% render 'responsive-image-lazyload',
                                desktop_image: main_desktop_image,
                                mobile_image: main_mobile_image,
                                class: 'custom--image',
                                sizes: '(max-width: 749px) 100vw, 100vw'
                            %}
                        </div>
                    </div>
                {%- endif -%}
                {%- if section.blocks.size > 0 -%}
                    <div class="science__loop show--desktop">
                        <div class="science__loop-wrap">
                            {%- assign half = section.blocks.size | divided_by: 2 -%}
                            <div class="science__leftside">
                                {%- for block in section.blocks -%}
                                    {%- liquid
                                        assign icon = block.settings.icon
                                        assign title = block.settings.title
                                        assign detail = block.settings.detail
                                    -%}
                                    {%- if forloop.index0 < half -%}
                                        {%- if icon != blank or title != blank or detail != blank -%}
                                            <div class="science__block">
                                                {%- if icon != blank -%}
                                                    <div class="science__block-image">
                                                        {% render 'responsive-image-lazyload',
                                                            desktop_image: icon,
                                                            mobile_image: icon,
                                                            class: 'custom--image',
                                                            sizes: '(max-width: 749px) 100vw, 100vw'                                                            
                                                        %}
                                                    </div>
                                                {%- endif -%}
                                                {%- if title != blank -%}
                                                    <div class="science__block-title">
                                                        {{ title }}
                                                    </div>
                                                {%- endif -%}
                                                {%- if detail != blank -%}
                                                    <div class="text-common science__block-infos">
                                                        {{ detail }}
                                                    </div>
                                                {%- endif -%}                                                
                                            </div>
                                        {%- endif -%}
                                    {%- endif -%}
                                {%- endfor -%}
                            </div>
                            <div class="science__rightside">
                                {%- for block in section.blocks -%}
                                    {%- liquid
                                        assign icon = block.settings.icon
                                        assign title = block.settings.title
                                        assign detail = block.settings.detail
                                    -%}
                                    {%- if forloop.index0 >= half -%}
                                        {%- if icon != blank or title != blank or detail != blank -%}
                                            <div class="science__block">
                                                {%- if icon != blank -%}
                                                    <div class="science__block-image">
                                                        {% render 'responsive-image-lazyload',
                                                            desktop_image: icon,
                                                            mobile_image: icon,
                                                            class: 'custom--image',
                                                            sizes: '(max-width: 749px) 100vw, 100vw'                                                            
                                                        %}
                                                    </div>
                                                {%- endif -%}
                                                {%- if title != blank -%}
                                                    <div class="science__block-title">
                                                        {{ title }}
                                                    </div>
                                                {%- endif -%}
                                                {%- if detail != blank -%}
                                                    <div class="text-common science__block-infos">
                                                        {{ detail }}
                                                    </div>
                                                {%- endif -%}                                                
                                            </div>
                                        {%- endif -%}
                                    {%- endif -%}
                                {%- endfor -%}
                            </div>                            
                        </div>
                    </div>
                {%- endif -%}
                {%- if section.blocks.size > 0 -%}
                    <div class="science__item show--mobile">
                        <div class="science__item-wrap">
                            <div class="accordion">
                                <ul class="list-unstyled">
                                    {%- for block in section.blocks -%}
                                        {%- liquid
                                            assign icon = block.settings.icon
                                            assign title = block.settings.title
                                            assign detail = block.settings.detail
                                        -%}
                                        {%- if title != blank and detail != blank -%}
                                            <li>
                                                {%- if icon != blank or title != blank -%}
                                                    <div class="question">
                                                        <div class="science__both">
                                                            {%- if icon != blank -%}
                                                                <div class="science__both-image">
                                                                    {% render 'responsive-image-lazyload',
                                                                        desktop_image: icon,
                                                                        mobile_image: icon,
                                                                        class: 'custom--image',
                                                                        sizes: '(max-width: 749px) 100vw, 100vw'
                                                                    %}
                                                                </div>
                                                            {%- endif -%}
                                                            {%- if title != blank -%}
                                                                <div class="science__both-title">
                                                                    {{ title }}
                                                                </div>
                                                            {%- endif -%}
                                                        </div>
                                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.28089 6.02653C1.25652 6.01912 1.27994 5.95083 1.26361 5.92967C1.19569 5.84053 1.19838 5.77964 1.14535 5.69056C1.06678 5.55843 0.693839 5.30603 1.01242 4.98744C1.01243 4.98743 1.01243 4.98742 1.01244 4.98742C1.01557 4.98429 1.01876 4.98116 1.02201 4.97803C1.0838 4.91843 1.17666 4.87876 1.24924 4.81407C1.32185 4.74934 1.7622 4.30308 1.82489 4.31593C1.9125 4.33786 1.93021 4.5829 1.96446 4.60707C1.9879 4.62357 2.05279 4.60786 2.08548 4.62623C2.19087 4.6855 2.20448 4.75805 2.38812 4.72276C2.36011 4.81012 2.33209 4.89747 2.30407 4.98483C2.36953 4.9968 2.35212 5.13155 2.37983 5.15088C2.40256 5.16672 2.45949 5.13242 2.48172 5.1504C2.50691 5.17032 2.49231 5.2542 2.54075 5.28781C2.61994 5.34313 2.75091 5.23609 2.80638 5.26134C2.86386 5.28754 2.86426 5.4173 2.95953 5.42882C2.97932 5.42242 2.99911 5.41603 3.0189 5.40964C3.0437 5.37523 3.06851 5.34083 3.09332 5.30642C3.134 5.31953 3.08489 5.39177 3.1085 5.41759C3.13625 5.44799 3.20861 5.4053 3.22791 5.42513C3.24367 5.44142 3.21928 5.50928 3.24295 5.52717C3.27723 5.5535 3.3372 5.48027 3.36596 5.48412C3.37731 5.48578 3.53434 5.5693 3.54165 5.57556C3.59589 5.62454 3.50922 5.72019 3.5424 5.76931C3.63479 5.90518 3.82561 5.94868 3.95902 6.02642C4.01862 6.0611 4.0625 6.11559 4.09493 6.17717C3.78759 6.33644 3.76987 6.68185 4.07366 6.25551C4.07402 6.35974 4.20965 6.29828 4.24257 6.36452C4.26376 6.40745 4.23534 6.48026 4.28245 6.52473C4.36637 6.6033 4.59913 6.54828 4.36243 6.83171C4.50365 6.88124 4.49191 7.05818 4.75587 6.86297C4.79449 6.87354 4.72077 7.07332 4.72977 7.11948C4.73836 7.16306 4.87678 7.42497 4.90608 7.46116C4.93538 7.49735 4.98895 7.55842 5.03667 7.56586C5.09624 7.57559 5.35854 7.3617 5.14185 7.70177C5.2361 7.75097 5.25368 7.78449 5.28805 7.88353C5.29428 7.90146 5.25431 7.94415 5.26133 7.95125C5.27587 7.96578 5.33114 7.95997 5.36081 7.98218C5.40957 8.01875 5.34695