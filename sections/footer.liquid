{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- liquid
  assign desktop_top_padding = section.settings.desktop_top_padding
  assign desktop_bottom_padding = section.settings.desktop_bottom_padding
  assign mobile_top_padding = section.settings.mobile_top_padding
  assign mobile_bottom_padding = section.settings.mobile_bottom_padding

  assign enable_social_icons = section.settings.enable_social_icons
  assign enable_newsletter_form = section.settings.enable_newsletter_form
  assign email_heading_size = section.settings.email_heading_size
  assign email_heading_text = section.settings.email_heading_text
  assign email_detail_text = section.settings.email_detail_text
  assign email_input_placeholder = section.settings.email_input_placeholder
  assign klaviyo_public_key = section.settings.klaviyo_public_key
  assign klaviyo_list_id = section.settings.klaviyo_list_id
  assign email_error_message = section.settings.email_error_message
  assign email_success_message = section.settings.email_success_message
  assign email_button_text = section.settings.email_button_text
  
  assign logo_background_color = section.settings.logo_background_color
  assign footer_logo_image = section.settings.footer_logo_image
  assign custom_desktop_image = section.settings.custom_desktop_image
  assign custom_mobile_image = section.settings.custom_mobile_image

  assign inner_background_color = section.settings.inner_background_color
  assign enable_footer_copyright = section.settings.enable_footer_copyright
  assign footer_copyright_text = section.settings.footer_copyright_text
  assign footer_bottom_menu = section.settings.footer_bottom_menu
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .footer__body {
      {%- if desktop_top_padding != blank -%}
          --desktop-top-padding: {{ desktop_top_padding }}px;
      {%- endif -%}
      {%- if desktop_bottom_padding != blank -%}
          --desktop-bottom-padding: {{ desktop_bottom_padding }}px;
      {%- endif -%}
      {%- if mobile_top_padding != blank -%}
          --mobile-top-padding: {{ mobile_top_padding }}px;
      {%- endif -%}
      {%- if mobile_bottom_padding != blank -%}
          --mobile-bottom-padding: {{ mobile_bottom_padding }}px;
      {%- endif -%}
      {%- if inner_background_color != blank -%}
          --inner-background-color: {{ inner_background_color }};
      {%- endif -%}
      {%- if logo_background_color != blank -%}
          --logo-background-color: {{ logo_background_color }};
      {%- endif -%}
      
  }
{%- endstyle -%}

{{ "footer.css" | asset_url | stylesheet_tag }}
<script src="{{ 'footer.js' | asset_url }}" defer></script>

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} footer__body">
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div class="footer__body-wrap">
    {%- if section.blocks.size > 0 or enable_newsletter_form == true -%}
      <div class="footer__side">
        <div class="page-width">
          <div class="footer__side-wrap">
            {%- if section.blocks.size > 0 -%}
              <div class="footer__loop">
                <div
                  class="
                    footer-content
                    spacing-style
                    {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
                    {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %} footer__loop-wrap"
                  style="
                    {%  render 'spacing-style', settings: section.settings %}
                    --footer-gap: {{ section.settings.gap }}px;
                    --grid-columns: {{ grid_columns }};
                    --last-row-count: {{ last_row_count }};
                    --tablet-last-row-count: {{ tablet_last_row_count }};
                  "
                >
                  {% content_for 'blocks' %}
                </div>
              </div>
            {%- endif -%}
            {%- if enable_newsletter_form == true and klaviyo_public_key != blank and klaviyo_list_id != blank -%}
              <div class="footer__email">
                <div class="footer__email-wrap">
                  {%- if email_heading_text != blank -%}
                    <div class="footer__email-wrap-title">
                      <{{ email_heading_size }} class="heading-s bold">
                        {{ email_heading_text | escape | newline_to_br }}
                      </{{ email_heading_size }}>
                    </div>
                  {%- endif -%}
                  {%- if email_detail_text != blank -%}
                    <div class="text-common footer__email-wrap-info">
                      {{ email_detail_text }}
                    </div>
                  {%- endif -%}
                  {%- if klaviyo_public_key != blank and klaviyo_list_id != blank -%}
                    <div class="footer__email-wrap-form">
                      <form
                        class="kl-footer-form"
                        data-klaviyo-form="{{ section.id }}"
                        data-public-key="{{ klaviyo_public_key | escape }}"
                        data-list-id="{{ klaviyo_list_id | escape }}"
                      >
                        <div class="kl-footer-form-input">
                          <label for="footer-email-{{ section.id }}" class="visually-hidden">
                            {{ email_input_placeholder | escape }}
                          </label>
                          <input
                            id="footer-email-{{ section.id }}"
                            type="email"
                            class="text-common bold kl-footer-input"
                            placeholder="{{ email_input_placeholder | escape }}"
                            autocomplete="email"
                            required
                          >
                        </div>
                        <button
                          type="submit"
                          class="kl-footer-submit common-button-flex"
                        >
                          <span class="button common-button">{{ email_button_text | escape }}</span>
                          <span class="common-button-icon">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                              <rect width="48" height="48" rx="24" fill="var(--color-joy)"/>
