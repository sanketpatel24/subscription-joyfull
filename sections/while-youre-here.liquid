</svg></span>
      </a>
    {% endif %}
  </div>
  </div>
</product-recommendations>

{% schema %}
{
  "name": "While you're here",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "While you’re here"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Recommendation source product",
      "info": "Leave blank to use the current product."
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary" }
      ],
      "default": "related"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shop all collection",
      "info": "Also supplies products in the theme editor when no source product is available."
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "number",
      "id": "products_to_show",
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "number",
      "id": "columns_desktop",
      "label": "Desktop products visible",
      "default": 4
    },
    {
      "type": "number",
      "id": "card_width_mobile",
      "label": "Mobile card width",
      "default": 262
    },
    {
      "type": "number",
      "id": "gap_desktop",
      "label": "Desktop product gap",
      "default": 16
    },
    {
      "type": "number",
      "id": "gap_mobile",
      "label": "Mobile product gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Shop all button"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show shop all button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP ALL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fff9f0"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "While you're here",
      "category": "Products"
    }
  ]
}
{% endschema %}
