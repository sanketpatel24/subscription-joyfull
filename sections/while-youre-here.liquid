{{ 'while-youre-here.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-recommendations.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'while-youre-here.js' | asset_url }}" defer></script>

{% liquid
  assign source_product = section.settings.product | default: product
  assign comparison = source_product.metafields.custom.comparison_section.value
  assign cta_icon = comparison.cta_icon.value
  assign shop_all_url = section.settings.collection.url | default: routes.all_products_collection_url

  if recommendations.performed
    assign recommended_products = recommendations.products
    if recommended_products.size == 0 and section.settings.recommendation_type == 'related'
      assign recommended_products = collections.all.products | reject: 'id', source_product.id
    endif
  endif
%}

<product-recommendations
  id="WhileYoureHere-{{ section.id }}"
  class="while-youre-here"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ source_product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="while-youre-here-{{ section.id }}"
  style="
    --wyh-padding-top-desktop: {{ section.settings.padding_top_desktop | default: 56 }}px;
    --wyh-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop | default: 56 }}px;
    --wyh-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 40 }}px;
    --wyh-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 32 }}px;
    --wyh-gap-desktop: {{ section.settings.gap_desktop | default: 16 }}px;
    --wyh-gap-mobile: {{ section.settings.gap_mobile | default: 16 }}px;
    --wyh-card-width-mobile: {{ section.settings.card_width_mobile | default: 262 }}px;
    --wyh-columns-desktop: {{ section.settings.columns_desktop | default: 4 }};
    --wyh-background: {{ section.settings.background_color | default: '#fff9f0' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="while-youre-here__inner">
    <div class="page-width">
    <div class="while-youre-here__header">
      <h2 class="while-youre-here__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.show_shop_all %}
        <div class="while-youre-here__shop-all-wrap">
          <a class="while-youre-here__shop-all while-youre-here__shop-all--desktop" href="{{ shop_all_url }}">
            {{ section.settings.button_label | escape }}
          </a>
          {%- if cta_icon != blank -%}
            <a class="product-comparison-cta-icon" href="{{ shop_all_url }}" tabindex="-1" aria-hidden="true">
              {{-
                cta_icon
                | image_url: width: 128
                | image_tag:
                  widths: '32, 64, 96, 128',
                  sizes: '32px',
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'product-comparison-cta-icon-image',
                  alt: ''
              -}}
            </a>
          {%- endif -%}
        </div>
      {% endif %}
    </div>

    {% if recommendations.performed or source_product == blank %}
      {% if source_product == blank %}
        {% assign recommended_products = section.settings.collection.products %}
      {% endif %}

      {% if recommended_products != blank %}
        <while-youre-here-slider class="while-youre-here__slider swiper" data-while-youre-here-slider>
          <div class="swiper-wrapper">
            {% for recommendation in recommended_products limit: section.settings.products_to_show %}
              <div class="while-youre-here__slide swiper-slide">
                {% content_for 'block',
                  type: '_product-card',
                  id: 'static-product-card',
                  closest.product: recommendation
                %}
              </div>
            {% endfor %}
          </div>
        </while-youre-here-slider>
      {% endif %}
    {% else %}
      <div class="while-youre-here__skeletons" aria-label="{{ 'accessibility.loading_product_recommendations' | t }}">
        {% for index in (1..4) %}
          <div class="while-youre-here__skeleton"></div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_shop_all %}
      <a class="while-youre-here__shop-all while-youre-here__shop-all--mobile" href="{{ shop_all_url }}">
        <span>{{ section.settings.button_label | escape }}</span>
        <span class="while-youre-here__paw" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="25" viewBox="0 0 28 25" fill="none">
