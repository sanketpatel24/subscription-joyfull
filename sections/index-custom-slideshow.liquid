{%- liquid
    assign desktop_top_padding = section.settings.desktop_top_padding
    assign desktop_bottom_padding = section.settings.desktop_bottom_padding
    assign mobile_top_padding = section.settings.mobile_top_padding
    assign mobile_bottom_padding = section.settings.mobile_bottom_padding
    assign main_heading_size = section.settings.main_heading_size
-%}

{%- if section.blocks.size > 0 -%}
    {{ 'index-custom-slideshow.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'index-custom-slideshow.js' | asset_url }}" defer></script>

    {%- style -%}
        #shopify-section-{{ section.id }} .slideshow {
            {%- if desktop_top_padding != blank -%}
                --desktop-top-padding: {{ desktop_top_padding }}px;
            {%- endif -%}
            {%- if desktop_bottom_padding != blank -%}
                --desktop-bottom-padding: {{ desktop_bottom_padding }}px;
            {%- endif -%}
            {%- if mobile_top_padding != blank -%}
                --mobile-top-padding: {{ mobile_top_padding }}px;
            {%- endif -%}
            {%- if mobile_bottom_padding != blank -%}
                --mobile-bottom-padding: {{ mobile_bottom_padding }}px;
            {%- endif -%}
        }
    {%- endstyle -%}

    <section class="slideshow">
        <div class="slideshow__body">
            <div class="swiper{% if section.blocks.size > 1 %} index-custom-slideshow-slider{% endif %}">
                <div class="swiper-wrapper">
                    {%- for block in section.blocks -%}
                        {%- case block.type -%} 
                            {% when 'split_banner_content' %}
                                {%- render 'slideshow-split-banner-content', block: block, main_heading_size: main_heading_size, forloop_index: forloop.index -%}                                

                            {% when 'full_bleed_with_box' %}
                                {%- render 'slideshow-full-bleed-with-box', block: block, main_heading_size: main_heading_size, forloop_index: forloop.index -%}                                

                            {% when 'full_bleed_with_text' %}
                                {%- render 'slideshow-full-bleed-with-text', block: block, main_heading_size: main_heading_size, forloop_index: forloop.index -%}                                

                        {%- endcase -%}
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </section>
{%- endif -%}

