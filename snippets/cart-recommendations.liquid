66602C5.70346 2.24625 5.87324 1.68655 6.01074 1.22363Z" stroke="currentColor"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="cart-recommendations__review-count desktop_count_text">
                    {{- 'content.cart_recommendations_reviews_count' | t: count: recommended_rating_count -}}
                  </span>
                  <span class="cart-recommendations__review-count mobile_count_text">
                    ({{- recommended_rating_count -}})
                  </span>
                </div>
              {%- endif -%}
              {% if recommended_product.metafields.custom.product_display_title.value != blank %}
                <a class="cart-recommendations__title" href="{{ recommended_product.url }}">
                  {{ recommended_product.metafields.custom.product_display_title.value | escape }}
                </a>
              {% else %}
                <a class="cart-recommendations__title" href="{{ recommended_product.url }}">
                  {{ recommended_product.title | escape }}
                </a>
              {% endif %}

              {%- if recommended_supporting_text != blank -%}
                <p class="cart-recommendations__description">{{ recommended_supporting_text | escape }}</p>
              {%- endif -%}

              <product-form-component
                class="cart-recommendations__form"
                data-section-id="{{ section_id }}"
                data-product-id="{{ recommended_product.id }}"
                data-product-url="{{ recommended_product.url }}"
                on:submit="/handleSubmit"
              >
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                {%- assign recommendation_form_id = 'CartRecommendationForm-' | append: section_id | append: '-' | append: forloop.index -%}
                {%- form 'product', recommended_product, id: recommendation_form_id, data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" ref="variantId" value="{{ recommended_variant.id }}">
                  <button
                    class="cart-recommendations__button"
                    type="submit"
                    name="add"
                    ref="addToCartButton"
                    {% unless recommended_variant.available %}disabled{% endunless %}
                  >
                    <span>
                      {%- if recommended_variant.available -%}
                        {%- assign recommended_variant_price = recommended_variant.price | money_without_trailing_zeros -%}
                        {{- 'content.cart_recommendations_add' | t: price: recommended_variant_price -}}
                        {%- if recommended_variant.compare_at_price > recommended_variant.price -%}
                          <s>{{ recommended_variant.compare_at_price | money_without_trailing_zeros }}</s>
                        {%- endif -%}
                      {%- else -%}
                        {{- 'content.cart_recommendations_sold_out' | t -}}
                      {%- endif -%}
                    </span>
                  </button>
                {%- endform -%}
              </product-form-component>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    </cart-recommendations-slider>
  </div>
{%- endif -%}
