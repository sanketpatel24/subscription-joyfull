{%- unless settings.type_body_font.system? -%}
  {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'auto' }}
{%- endunless -%}
{%- unless settings.type_subheading_font.system? -%}
  {{ settings.type_subheading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'auto' }}
{%- endunless -%}
{%- unless settings.type_heading_font.system? -%}
  {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'auto' }}
{%- endunless -%}
{%- unless settings.type_accent_font.system? -%}
  {{ settings.type_accent_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}

<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'Figtree-Regular.woff2' | file_url }}" fetchpriority="high">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'Figtree-Bold.woff2' | file_url }}" fetchpriority="high">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'DaimitoCondensed-Bold.woff2' | file_url }}" fetchpriority="high">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'BurnedPancakes-Regular.woff2' | file_url }}" fetchpriority="low">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'BurnedPancakes-Bold.woff2' | file_url }}" fetchpriority="low">

{%- style -%}

  @font-face {
      font-family: 'Figtree';
      src: url("{{'Figtree-Regular.woff2' | file_url }}") format('woff2'),
          url("{{'Figtree-Regular.woff' | file_url }}" ) format('woff');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
  }

  @font-face {
