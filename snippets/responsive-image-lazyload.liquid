{%- comment -%}
USAGE EXAMPLE:
  {% render 'responsive-image',
      desktop_image: section.settings.desktop_image,
      mobile_image: section.settings.mobile_image,
      alt: 'Hero Banner',
      class: 'hero-banner',
      sizes: '(max-width: 749px) 100vw, 100vw' %}
{%- endcomment -%}

{%- assign desktop = desktop_image -%}
{%- assign mobile = mobile_image | default: desktop -%}
{% liquid
  assign alt_text = alt
  if alt_text == blank
    assign alt_text = desktop.alt
  endif
  if alt_text == blank
    assign alt_text = mobile.alt
  endif
  if alt_text == blank
    assign alt_text = desktop | split: '/' | last | split: '.' | first | replace: '-', ' ' | replace: '_', ' '
  endif
%}
{%- assign sizes_attr = sizes | default: '100vw' -%}
{%- assign classes = class | default: '' -%}
{%- assign fetchpriority = fetchpriority | default: 'low' -%}
{%- assign loading = loading | default: 'lazy' -%}
{%- assign rel = rel | default: '' -%}

{%- comment -%}
  mobile_widths / desktop_widths let a caller request a smaller candidate
  ladder for small images (icons, logos, badges) instead of the default
  hero-sized ladder. Omitting them reproduces the exact previous output.
{%- endcomment -%}
{%- assign mobile_widths = mobile_widths | default: '480, 749' | split: ', ' -%}
{%- assign desktop_widths = desktop_widths | default: '1200, 1600, 2000' | split: ', ' -%}
{%- assign img_src_width = desktop_widths[1] | default: desktop_widths[0] -%}

{%- capture mobile_srcset_webp -%}
  {%- for w in mobile_widths -%}
    {{- mobile | image_url: width: w, format: 'webp' }} {{ w }}w{% unless forloop.last %}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture mobile_srcset -%}
  {%- for w in mobile_widths -%}
    {{- mobile | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture desktop_srcset_webp -%}
  {%- for w in desktop_widths -%}
    {{- desktop | image_url: width: w, format: 'webp' }} {{ w }}w{% unless forloop.last %}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture desktop_srcset -%}
  {%- for w in desktop_widths -%}
    {{- desktop | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}

<picture class="{{ classes }}">
  <!-- Mobile first: load smaller image on small screens -->
  <source
    media="(max-width: 749px)"
    type="image/webp"
    srcset="{{ mobile_srcset_webp }}"
    sizes="{{ sizes_attr }}">
  <source
    media="(max-width: 749px)"
    srcset="{{ mobile_srcset }}"
    sizes="{{ sizes_attr }}">

  <!-- Desktop: higher resolution -->
  <source
    type="image/webp"
    srcset="{{ desktop_srcset_webp }}"
    sizes="{{ sizes_attr }}">
  <source
    srcset="{{ desktop_srcset }}"
    sizes="{{ sizes_attr }}">

  <img
    src="{{ desktop | image_url: width: img_src_width }}"
    alt="{{ alt_text | escape }}"
    loading="{{ loading }}"
    rel="{{ rel }}"
    decoding="async"
    width="{{ desktop.width }}"
    height="{{ desktop.height }}"
    fetchpriority="{{ fetchpriority }}"
    class=""
  >
</picture>