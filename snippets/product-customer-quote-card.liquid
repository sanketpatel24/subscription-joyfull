          {%- endfor -%}
        </div>
      {%- endif -%}
      <blockquote class="product-customer-quote__quote">
        <span>“</span>{{ customer_quote.quote.value | escape }}<span>”</span>
        {%- if customer_quote.author.value != blank -%}
          <cite> – {{ customer_quote.author.value | escape }}</cite>
        {%- endif -%}
      </blockquote>
    </div>

    {%- if customer_quote.badge_image.value != blank -%}
      {{
        customer_quote.badge_image.value
        | image_url: width: 400
        | image_tag:
          class: 'product-customer-quote__badge',
          widths: '120, 180, 240, 320, 400',
          sizes: '(max-width: 749px) 96px, 120px',
          loading: 'lazy'
      }}
    {%- endif -%}
  </aside>
{%- endif -%}
