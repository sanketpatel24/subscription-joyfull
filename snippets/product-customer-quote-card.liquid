{% doc %}
  Renders custom.customer_quote metaobject fields: quote and author.
  @param {product} product
  @param {string} placement - "desktop" or "mobile"
{% enddoc %}

{%- liquid
  assign customer_quote = product.metafields.custom.customer_quote.value
  assign placement = placement | default: 'mobile'
  assign background_image = customer_quote.desktop_background_image.value
  assign star_count = customer_quote.star_count.value | default: 5
  assign star_color = customer_quote.star_color.value | default: '#2F261C'
  assign text_color = customer_quote.text_color.value | default: '#2F261C'

  if placement == 'mobile' and customer_quote.mobile_background_image.value != blank
    assign background_image = customer_quote.mobile_background_image.value
  endif
-%}

{%- if customer_quote != blank and background_image != blank -%}
  <aside
    class="product-customer-quote product-customer-quote--{{ placement }}"
    style="--customer-quote-text: {{ text_color }}; --customer-quote-stars: {{ star_color }};"
    aria-label="Customer testimonial"
  >
    {{
      background_image
      | image_url: width: 1600
      | image_tag:
        class: 'product-customer-quote__background',
        widths: '360, 540, 720, 900, 1200, 1600',
        sizes: '(max-width: 749px) 100vw, 50vw',
        loading: 'lazy'
    }}
    <div class="product-customer-quote__content">
      {%- if star_count > 0 -%}
        <div class="product-customer-quote__stars" aria-label="{{ star_count }} out of 5 stars">
          {%- for star in (1..star_count) -%}
            <span aria-hidden="true">
