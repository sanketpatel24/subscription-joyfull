{%- liquid
    assign main_background_color = block.settings.main_background_color
    assign main_information_color = block.settings.main_information_color

    assign main_desktop_video = block.settings.main_desktop_video
    assign main_desktop_image = block.settings.main_desktop_image
    assign main_mobile_video = block.settings.main_mobile_video
    assign main_mobile_image = block.settings.main_mobile_image

    assign custom_text = block.settings.custom_text
    assign heading_text = block.settings.heading_text
    assign details_text = block.settings.details_text
    assign button_text = block.settings.button_text
    assign button_link = block.settings.button_link
    assign button_style = block.settings.button_style

    assign custom_image_1 = block.settings.custom_image_1
    assign custom_image_2 = block.settings.custom_image_2

    if forloop_index == 1
        assign img_loading = 'eager'
        assign img_fetchpriority = 'high'
        assign img_rel = 'preload'
    else
        assign img_loading = 'lazy'
        assign img_fetchpriority = 'low'
        assign img_rel = ''
    endif
-%}

{%- style -%}
    #shopify-section-{{ section.id }} .slideshow-text__{{ block.id }} {
        {%- if main_background_color != blank -%}
            --background-color: {{ main_background_color }};
        {%- endif -%}
        {%- if main_information_color != blank -%}
            --information-color: {{ main_information_color }};
        {%- endif -%}
    }
{%- endstyle -%}

{%- if main_desktop_video != blank or main_desktop_image != blank or main_mobile_video != blank or main_mobile_image != blank or custom_text != blank or heading_text != blank or details_text != blank or button_link != blank or custom_image_1 != blank or custom_image_2 != blank -%}
    <div class="swiper-slide slideshow-text slideshow-text__{{ block.id }}" data-need-transparent-header="false">
        <div class="slideshow-text__body">
            {%- if main_desktop_video != blank or main_desktop_image != blank or main_mobile_video != blank or main_mobile_image != blank -%}
                {% if main_mobile_video != blank or main_mobile_image != blank %}
                    {% assign video_class = "video--desktop" %}
                {% else %}
                    {% assign video_class = "video--desktop video--mobile" %}
                {% endif %}
                {%- if main_desktop_video != blank or main_desktop_image != blank -%}
                    <div class="slideshow-text__media{% if main_mobile_video != blank or main_mobile_image != blank %} show--desktop{% endif %}">
                        <div class="slideshow-text__media-wrap">
                            {%- if main_desktop_video != blank -%}
                                {% render 'responsive-video-lazyload',
                                    video_url: main_desktop_video,
                                    class: video_class
                                %}
                            {%- elsif main_desktop_image != blank -%}
                                {% render 'responsive-image-lazyload',
                                    desktop_image: main_desktop_image,
                                    mobile_image: main_desktop_image,
                                    class: 'custom--image',
                                    sizes: '(max-width: 749px) 100vw, 100vw',
                                    fetchpriority: img_fetchpriority,
                                    loading: img_loading,
                                    rel: img_rel
                                %}
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
                {%- if main_mobile_video != blank or main_mobile_image != blank -%}
                    <div class="slideshow-text__media show--mobile">
                        <div class="slideshow-text__media-wrap">
                            {%- if main_mobile_video != blank -%}
                                {% render 'responsive-video-lazyload',
                                    video_url: main_mobile_video,
                                    class: 'video--mobile'
                                %}
                            {%- elsif main_mobile_image != blank -%}
                                {% render 'responsive-image-lazyload',
                                    desktop_image: main_mobile_image,
                                    mobile_image: main_mobile_image,
                                    class: 'custom--image',
                                    sizes: '(max-width: 749px) 100vw, 100vw',
                                    fetchpriority: img_fetchpriority,
                                    loading: img_loading,
                                    rel: img_rel
                                %}
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
            {%- endif -%}
            {%- if custom_text != blank or heading_text != blank or details_text != blank or button_link != blank or custom_image_1 != blank or custom_image_2 != blank -%}
                <div class="slideshow-text__block">
                    <div class="page-width">
                        <div class="slideshow-text__block-wrap">
                            {%- if custom_text != blank or heading_text != blank or details_text != blank or button_link != blank -%}
                                <div class="slideshow-text__list">
                                    <div class="slideshow-text__list-wrap">
                                        {%- if custom_text != blank -%}
                                            <div class="title-small title-small--caps slideshow-text__list-wrap-text">
                                                {{ custom_text | escape | newline_to_br }}
                                            </div>
                                        {%- endif -%}
                                        {%- if heading_text != blank -%}
                                            <div class="slideshow-text__list-wrap-title">
                                                {%- if forloop_index == 1 -%}
                                                    <{{ main_heading_size }} class="heading-l">
                                                {%- else -%}
                                                    <h2 class="heading-l">
                                                {%- endif -%}
                                                        {{ heading_text | escape | newline_to_br }}
                                                {%- if forloop_index == 1 -%}
                                                    </{{ main_heading_size }}>
                                                {%- else -%}
                                                </h2>
                                                {%- endif -%}
                                            </div>
                                        {%- endif -%}
                                        {%- if details_text != blank -%}
                                            <div class="text-common slideshow-text__list-wrap-info">
                                                {{ details_text }}
                                            </div>                                    
                                        {%- endif -%}
                                        {%- if button_text != blank and button_link != blank -%}                                    
                                            <div class="slideshow-text__list-wrap-link">
                                                {%- render 'button-common-style',                                                  
                                                    main_button_text: button_text, 
                                                    main_button_link: button_link,
                                                    main_button_style: button_style
                                                -%}
                                            </div>                                    
                                        {%- endif -%}
                                    </div>
                                </div>
                            {%- endif -%}
                            {%- if custom_image_1 != blank or custom_image_2 != blank -%}
                                <div class="slideshow-text__both show--desktop">
                                    <div class="slideshow-text__both-wrap">
                                        {%- if custom_image_1 != blank -%}
                                            <div class="slideshow-text__both-wrap-image">
                                                {% render 'responsive-image-lazyload',
                                                    desktop_image: custom_image_1,
                                                    mobile_image: custom_image_1,
                                                    class: 'Custom_icon_new',
                                                    sizes: '224px',
                                                    desktop_widths: '224, 448',
                                                    mobile_widths: '224, 448',
                                                    fetchpriority: img_fetchpriority,
                                                    loading: img_loading,
                                                    rel: img_rel
                                                %}
                                            </div>
                                        {%- endif -%}
                                        {%- if custom_image_2 != blank -%}
                                            <div class="slideshow-text__both-wrap-image">
                                                {% render 'responsive-image-lazyload',
                                                    desktop_image: custom_image_2,
                                                    mobile_image: custom_image_2,
                                                    class: 'Custom_icon_new',
                                                    sizes: '224px',
                                                    desktop_widths: '224, 448',
                                                    mobile_widths: '224, 448',
                                                    fetchpriority: img_fetchpriority,
                                                    loading: img_loading,
                                                    rel: img_rel
                                                %}
                                            </div>
                                        {%- endif -%}
                                    </div>
                                </div>
                            {%- endif -%}
                        </div>
                    </div>
                </div>
            {%- endif -%}            
        </div>
    </div>
{%- endif -%}