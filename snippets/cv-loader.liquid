{% comment %}
	Loader Component - Accessible loading spinner using the theme's existing spinner animation

	Props: {
		/** Size of the spinner */
		size?: "small" | "base" = "base";
	}

	Usage:
		{% render 'cv-loader' %}
		{% render 'cv-loader', size: 'small' %}
{% endcomment %}

{% liquid
	assign size = size | default: 'base'
%}

<div
	class="
		cv-loader
		cv-loader--size-{{ size }}
	"
	role="status"
	aria-label="Loading"
>
	<svg xmlns="http://www.w3.org/2000/svg" class="spinner" viewBox="0 0 66 66">
		<circle stroke-width="6" cx="33" cy="33" r="30" fill="none" class="path"></circle>
	</svg>
</div>
