{% doc %}
  Renders the product's veterinary endorsement metaobject.

  Expected product metafield:
    custom.vet_formulated (Metaobject reference)

  Expected metaobject fields:
    image, heading, quote, expert_name, credentials, role

  @param {product} product - Product whose endorsement should be rendered
  @param {string} placement - Either "desktop" or "mobile"
{% enddoc %}

{%- liquid
  assign endorsement = product.metafields.custom.vet_formulated.value
  assign placement = placement | default: 'mobile'
-%}

{%- if endorsement != blank -%}
  <aside
    class="product-vet-card product-vet-card--{{ placement }}"
    aria-label="{{ endorsement.heading.value | default: 'Veterinary endorsement' | escape }}"
  >
    {%- if endorsement.image.value != blank -%}
      <div class="product-vet-card__media">
        {{
          endorsement.image.value
          | image_url: width: 1200
          | image_tag:
            class: 'product-vet-card__image',
            widths: '320, 480, 640, 800, 1000, 1200',
            sizes: '(max-width: 749px) 100vw, 50vw',
            loading: 'lazy'
        }}
      </div>
    {%- endif -%}

    <div class="product-vet-card__content">
      {%- if endorsement.heading.value != blank -%}
        <h2 class="product-vet-card__heading">
          <span class="product-vet-card__verified" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M16.7871 9.00051L17.9437 6.93251C18.0003 6.83007 18.0149 6.70965 17.9844 6.59666C17.9539 6.48367 17.8807 6.38695 17.7802 6.32694L15.7426 5.11581L15.7123 2.74502C15.7107 2.62666 15.663 2.51358 15.5793 2.42988C15.4956 2.34618 15.3826 2.29847 15.2642 2.2969L12.8936 2.26662L11.6795 0.219807C11.6195 0.119329 11.5228 0.0461051 11.4098 0.0155975C11.2968 -0.0149101 11.1764 -0.000313783 11.0739 0.0563045L9 1.21294L6.93211 0.0563045C6.82969 -0.000313783 6.70927 -0.0149101 6.59628 0.0155975C6.4833 0.0461051 6.38659 0.119329 6.32658 0.219807L5.11552 2.25754L2.74486 2.28781C2.62651 2.28938 2.51344 2.3371 2.42974 2.4208C2.34605 2.5045 2.29834 2.61757 2.29677 2.73593L2.26649 5.10672L0.219795 6.32088C0.119322 6.3809 0.0461025 6.47761 0.0155966 6.5906C-0.0149093 6.70359 -0.000313765 6.82402 0.0563013 6.92645L1.21287 9.00051L0.0563013 11.0685C-0.000313765 11.171 -0.0149093 11.2914 0.0155966 11.4044C0.0461025 11.5174 0.119322 11.6141 0.219795 11.6741L2.25741 12.8852L2.28768 15.256C2.28925 15.3744 2.33697 15.4874 2.42066 15.5711C2.50436 15.6548 2.61742 15.7026 2.73578 15.7041L5.10643 15.7344L6.3175 17.7721C6.37751 17.8726 6.47421 17.9458 6.5872 17.9763C6.70018 18.0069 6.8206 17.9923 6.92303 17.9356L9 16.7881L11.0679 17.9447C11.1705 18.0006 11.2906 18.0147 11.4034 17.9843C11.5162 17.9538 11.6129 17.8811 11.6734 17.7812L12.8845 15.7435L15.2551 15.7132C15.3735 15.7116 15.4866 15.6639 15.5703 15.5802C15.654 15.4965 15.7017 15.3835 15.7032 15.2651L15.7335 12.8943L17.7711 11.6832C17.8716 11.6232 17.9448 11.5264 17.9753 11.4135C18.0058 11.3005 17.9912 11.18 17.9346 11.0776L16.7871 9.00051ZM12.4364 6.88103C10.9762 8.34485 9.66677 9.9516 8.52769 11.6771C8.49128 11.7373 8.44147 11.7883 8.38212 11.8261C8.32278 11.864 8.25552 11.8876 8.18556 11.8951H8.14015C8.07756 11.8955 8.01559 11.8828 7.95823 11.8577C7.90087 11.8327 7.84939 11.7959 7.8071 11.7498L5.55453 9.3033C5.48956 9.21264 5.46022 9.10125 5.4721 8.99036C5.48398 8.87946 5.53624 8.77681 5.61893 8.70198C5.70162 8.62714 5.80895 8.58535 5.92047 8.58456C6.032 8.58378 6.13991 8.62406 6.22364 8.69773L8.0917 10.7052C9.19484 9.11596 10.4305 7.62296 11.7854 6.24216C11.871 6.15784 11.9863 6.11057 12.1064 6.11057C12.2265 6.11057 12.3418 6.15784 12.4273 6.24216C12.4699 6.28347 12.504 6.33278 12.5275 6.38727C12.551 6.44176 12.5636 6.50036 12.5644 6.55971C12.5653 6.61906 12.5544 6.67799 12.5324 6.73313C12.5105 6.78827 12.4778 6.83853 12.4364 6.88103Z" fill="#2F57A4"/>
            </svg>
          </span>
          {{ endorsement.heading.value | escape }}
        </h2>
      {%- endif -%}

      {%- if endorsement.quote.value != blank -%}
        <div class="product-vet-card__quote">
          {{ endorsement.quote | metafield_tag }}
        </div>
      {%- endif -%}

      <div class="product-vet-card__footer">
        {%- if endorsement.image_mobile.value != blank -%}
          {{
            endorsement.image_mobile.value
            | image_url: width: 320
            | image_tag:
              class: 'product-vet-card__mobile-image',
              widths: '120, 180, 240, 320',
              sizes: '96px',
              loading: 'lazy'
          }}
        {%- endif -%}

        <div class="product-vet-card__attribution">
          {%- if endorsement.expert_name.value != blank or endorsement.credentials.value != blank -%}
            <p class="product-vet-card__expert">
              {%- if endorsement.expert_name.value != blank -%}
                <strong>{{ endorsement.expert_name.value | escape }}, </strong>
              {%- endif -%}
              {%- if endorsement.credentials.value != blank -%}
                <strong>{{ endorsement.credentials.value | escape }}</strong>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if endorsement.role.value != blank -%}
            <p class="product-vet-card__role">{{ endorsement.role.value | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </aside>
{%- endif -%}
